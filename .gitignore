# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
coverage/

# Environment and credentials
.env
.env.*
!.env.example

# Anything holding a token or key. Broad on purpose: the cost of ignoring a
# file that did not need it is nothing, and the cost of missing one is a leaked
# credential in public history.
.secret
.secret*
*.secret
secrets.json
.npmrc
*.pem
*.key
!tsconfig*.json

# Logs
*.log
npm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Vite cache
.vite/
